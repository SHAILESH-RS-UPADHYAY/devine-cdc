# Formspree form ID (or full endpoint URL) that the booking form posts to.
# REQUIRED in production - without it the booking form shows an error instead
# of accepting the lead. Get it from https://formspree.io/forms
NEXT_PUBLIC_FORMSPREE_ID=

# Separate Formspree form for worksheet downloads (Resources page), so they don't count
# against the consultation form's monthly limit. Optional: falls back to the ID above.
NEXT_PUBLIC_FORMSPREE_WORKSHEET_ID=

# Google Apps Script web app URL that appends every lead (with UTM source) to the clinic's
# Google Sheet. Optional: leave empty to send leads by email only. Setup: docs/leads-google-sheet.md
NEXT_PUBLIC_LEADS_SHEET_URL=
